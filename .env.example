ENVIRONMENT=development
SERVICE_NAME=edufurther-ai-router
SERVICE_ISSUER=edufurther-ai-router
SERVICE_AUDIENCE=edufurther-ai-router
SERVICE_JWT_PUBLIC_KEY=
SERVICE_JWT_KEYS={}
SERVICE_JWT_ALGORITHM=RS256
SERVICE_JWT_REQUIRED_SCOPE=
SERVICE_CALLERS={"scholarship_finder":{"subject":"scholarship-finder-worker","issuer":"scholarship-finder","audience":"edufurther-ai-router","keys":{},"scopes":["ai:execute"]}}
PROVIDER_KEYS={}
ROUTING_POLICY={"scholarship_extraction":{"models":["openai/model-a","anthropic/model-b"]},"match_explanation":{"models":["mistral/model-c","openrouter/model-d"]}}
MODEL_POLICY_VERSION=ai-policy-v1
DAILY_BUDGET_USD=25
PRODUCT_TASK_BUDGETS={}
PRODUCT_TASK_RATE_LIMITS={}
MAX_SOURCE_BYTES=16384
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
