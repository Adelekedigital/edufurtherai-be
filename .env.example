ENVIRONMENT=development
ALLOW_UNAUTHENTICATED_DEVELOPMENT=false
SERVICE_NAME=edufurther-ai-router
SERVICE_JWT_ALGORITHM=RS256
SERVICE_JWT_REQUIRED_SCOPE=
# "keys" must contain the caller's real public key(s), keyed by "kid", before any request from
# this caller can authenticate. See docs/authentication.md for how to generate and register one.
SERVICE_CALLERS={"scholarship_finder":{"subject":"scholarship-finder-worker","issuer":"scholarship-finder","audience":"edufurther-ai-router","keys":{},"scopes":["ai:execute"]},"edufurther_agent":{"subject":"edufurther-agent-worker","issuer":"edufurther-agent","audience":"edufurther-ai-router","keys":{},"scopes":["ai:execute"]}}
PROVIDER_KEYS={}
# Used for any task with no ROUTING_POLICY or TASK_MODELS entry. FALLBACK_MODEL is
# always appended last, so leaving it empty means a single-attempt task.
PRIMARY_MODEL=
FALLBACK_MODEL=
# Per-task model override, checked after ROUTING_POLICY and before
# PRIMARY_MODEL. Useful for giving one task a larger model without a
# routing policy entry - splitting a long list page, say.
TASK_MODELS={}
ROUTING_POLICY={"scholarship_extraction":{"models":["openai/model-a","anthropic/model-b"]},"match_explanation":{"models":["mistral/model-c","openrouter/model-d"]}}
MODEL_POLICY_VERSION=ai-policy-v1
DAILY_BUDGET_USD=25
PRODUCT_TASK_BUDGETS={}
PRODUCT_TASK_RATE_LIMITS={}
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
DATABASE_URL=postgresql+asyncpg://router_user:router_password@localhost:5432/edufurther_ai_router
